if (is_mac) {
  # [AP-FORM-IMAGE-WATERMARK] 打包水印资源
  bundle_data("watermark_resources") {
    sources = [
      "//platform/shared/Resources/watermark.jpeg",
    ]
    outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
  }
  
  executable("mac_pdf_viewer") {
    output_name = "mac_pdf_viewer"
    
    sources = [
      "App.mm",
      "LoggerHelper.mm",
      "LoggerHelper.h",
      
      # [AP-FORM-IMAGE-REPLACEMENT] 自定义图片替换回调
      "CustomImageCallback.h",
      "CustomImageCallback.mm",
      
      # Utils
      "Utils/LogManager.h",
      "Utils/LogManager.mm",
      "Utils/SettingsManager.h",
      "Utils/SettingsManager.mm",
      
      # Models
      "Models/TocNode.h",
      "Models/TocNode.mm",
      
      # Views
      "Views/SelectableTextView.h",
      "Views/SelectableTextView.mm",
      "Views/DragDropView.h",
      "Views/DragDropView.mm",
      "Views/PdfView.h",
      "Views/PdfView.mm",
      "Views/LoadingView.h",
      "Views/LoadingView.mm",
      
      # Controllers
      "Controllers/RecentFilesManager.h",
      "Controllers/RecentFilesManager.mm",
      "Controllers/StatusBarController.h",
      "Controllers/StatusBarController.mm",
      "Controllers/BookmarkPanelController.h",
      "Controllers/BookmarkPanelController.mm",
      "Controllers/InspectorPanelController.h",
      "Controllers/InspectorPanelController.mm",
      "Controllers/BookmarkDelegate.h",
      "Controllers/BookmarkDelegate.mm",
    ]
    
    deps = [
      "//:pdfium",
      "//platform/shared:pdf_utils",
      "//platform/shared:pdfium_object_info",
      "//platform/shared:logger",
      "//platform/shared:watermark_callback",  # [AP-FORM-IMAGE-WATERMARK]
      ":watermark_resources",  # [AP-FORM-IMAGE-WATERMARK] 水印资源
    ]
    
    frameworks = [
      "AppKit.framework",
      "CoreFoundation.framework",
      "UniformTypeIdentifiers.framework",
    ]
    
    configs += [
      "//:pdfium_strict_config",
    ]
    
    # Mac-specific settings
    ldflags = [
      "-framework", "AppKit",
      "-framework", "CoreFoundation",
      "-framework", "UniformTypeIdentifiers",
    ]
  }
}

